# FLX4 USB headphones end-to-end profile (Task 8 Step 1).
# Real P4 hp_out monitor mix -> I2S link -> ring -> FLX4 USB Audio phones.
# Build: idf.py -B build_flx4_hp_e2e -D SDKCONFIG="build_flx4_hp_e2e/sdkconfig" \
#   -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.flx4_hp_e2e" build
CONFIG_DDJ_FLX4_USB_AUDIO_HEADPHONES=y
CONFIG_DDJ_FLX4_USB_AUDIO_RING_AUTOSTART=y
CONFIG_P4_AUDIO_LINK_ENABLED=y
CONFIG_P4_AUDIO_LINK_BCLK_GPIO=7
CONFIG_P4_AUDIO_LINK_WS_GPIO=8
CONFIG_P4_AUDIO_LINK_DIN_GPIO=9
# No bench consumer: the FLX4 USB callback drains the ring instead.
# No tone autostart: ring streaming replaces the synthetic tone.

# FLX4 playback is an isochronous OUT endpoint; bias the USB host FIFO to
# periodic OUT (same as the tone smoke profile).
# CONFIG_USB_HOST_HW_BUFFER_BIAS_BALANCED is not set
# CONFIG_USB_HOST_HW_BUFFER_BIAS_IN is not set
CONFIG_USB_HOST_HW_BUFFER_BIAS_PERIODIC_OUT=y
