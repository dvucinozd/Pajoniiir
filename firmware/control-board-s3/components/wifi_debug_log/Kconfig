menu "Wi-Fi debug log"

config WIFI_DEBUG_LOG_ENABLED
    bool "Enable Wi-Fi UDP debug log"
    default n
    help
        Sends ESP logs over best-effort UDP in addition to the normal UART
        console. Keep disabled for production builds.

config WIFI_DEBUG_LOG_SSID
    string "Wi-Fi debug log SSID"
    default ""
    depends on WIFI_DEBUG_LOG_ENABLED
    help
        Development Wi-Fi SSID. Put real local credentials in ignored sdkconfig,
        not in versioned defaults.

config WIFI_DEBUG_LOG_PASSWORD
    string "Wi-Fi debug log password"
    default ""
    depends on WIFI_DEBUG_LOG_ENABLED
    help
        Development Wi-Fi password. Do not commit real passwords.

config WIFI_DEBUG_LOG_HOST
    string "Wi-Fi debug log UDP host IPv4"
    default ""
    depends on WIFI_DEBUG_LOG_ENABLED
    help
        PC IPv4 address running the UDP listener.

config WIFI_DEBUG_LOG_PORT
    int "Wi-Fi debug log UDP port"
    default 3333
    range 1 65535
    depends on WIFI_DEBUG_LOG_ENABLED

endmenu
