menu "DDJ-FLX4 MIDI Host"

config DDJ_FLX4_HOST_MODE
    bool "Enable DDJ-FLX4 USB MIDI host raw logger"
    default y
    help
        Enables the ESP32-S3 USB host spike for Pioneer DDJ-FLX4 raw MIDI
        capture. When enabled, the legacy TinyUSB MIDI device compatibility
        path is not started because the USB OTG peripheral is used as host.

config DDJ_FLX4_TRANSLATE_TO_P4
    bool "Translate DDJ-FLX4 USB MIDI to P4 control-link frames"
    depends on DDJ_FLX4_HOST_MODE
    default n
    help
        Enables the S3 USB host translator path. Keep this disabled until
        raw MIDI capture from the physical DDJ-FLX4 has confirmed the mapping.

config DDJ_FLX4_DUMP_USB_CONFIG_DESCRIPTOR
    bool "Dump DDJ-FLX4 active USB configuration descriptor"
    depends on DDJ_FLX4_HOST_MODE
    default n
    help
        Logs the raw active USB configuration descriptor in deterministic
        16-byte hex rows during FLX4 attach. Enable only for USB Audio
        descriptor capture because the output is intentionally verbose.

endmenu
