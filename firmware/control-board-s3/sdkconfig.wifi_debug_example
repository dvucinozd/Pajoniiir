# Example fragment for S3 Wi-Fi UDP debug logging.
#
# Do not put real Wi-Fi credentials in this committed file. Copy it to:
#   firmware/control-board-s3/sdkconfig.wifi_debug.local
# then fill SSID, password, and the PC IPv4 address that runs the UDP listener.
#
# Build example:
#   idf.py -B build_flx4_hp_e2e_xiao_wifi -D SDKCONFIG="build_flx4_hp_e2e_xiao_wifi/sdkconfig" \
#     -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.flx4_hp_e2e;sdkconfig.wifi_debug.local" build

CONFIG_WIFI_DEBUG_LOG_ENABLED=y
CONFIG_WIFI_DEBUG_LOG_SSID=""
CONFIG_WIFI_DEBUG_LOG_PASSWORD=""
CONFIG_WIFI_DEBUG_LOG_HOST=""
CONFIG_WIFI_DEBUG_LOG_PORT=3333
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
