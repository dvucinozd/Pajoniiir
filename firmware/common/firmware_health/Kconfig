menu "DDJ firmware health"

config DDJ_OTA_FORCE_ROLLBACK_TEST
    bool "Build an intentionally non-confirming OTA rollback test image"
    default n
    help
        Test-only fault injection. When an OTA image first boots in
        PENDING_VERIFY state, restart before marking it valid so the ESP-IDF
        bootloader must roll back to the prior valid slot. Keep this disabled
        for every production and packaged release image.

endmenu
