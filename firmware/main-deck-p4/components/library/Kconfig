menu "Media library"

config LIBRARY_ANLZ_CACHE_WRITE
    bool "Write parsed ANLZ metadata cache to microSD"
    default n if PAJONIIIR_P4_LOCAL_CONTROLLER
    default y
    help
        Cache cold USB ANLZ parses on microSD so later loads are faster. Disable
        this on hardware whose supply cannot tolerate the microSD commit current
        peak. Existing cache entries remain readable; only new writes are
        suppressed.

endmenu
