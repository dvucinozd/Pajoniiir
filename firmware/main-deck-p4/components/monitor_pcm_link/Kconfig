menu "Monitor PCM link"

config MONITOR_PCM_LINK_ENABLED
    bool "Enable monitor PCM link transport"
    default n
    help
        Enables the dedicated P4-to-S3 monitor PCM transport: an I2S TX master
        that streams framed P4HP blocks to the S3 p4_audio_link receiver.

config MONITOR_PCM_LINK_BCLK_GPIO
    int "Monitor PCM link I2S BCLK GPIO"
    default 32
    depends on MONITOR_PCM_LINK_ENABLED

config MONITOR_PCM_LINK_WS_GPIO
    int "Monitor PCM link I2S WS/LRCK GPIO"
    default 34
    depends on MONITOR_PCM_LINK_ENABLED

config MONITOR_PCM_LINK_DOUT_GPIO
    int "Monitor PCM link I2S DOUT GPIO"
    default 35
    depends on MONITOR_PCM_LINK_ENABLED

config MONITOR_PCM_LINK_I2S_UNIT
    int "Monitor PCM link I2S unit (0-1)"
    default 1
    range 0 1
    depends on MONITOR_PCM_LINK_ENABLED
    help
        I2S peripheral unit that drives the monitor link. Unit 2 freezes on the
        rev v1.3 (eco2) P4. Use unit 1 for the bench (ES8311 keeps unit 0); use
        unit 0 for the product config (ES8311 disabled, PCM5102A MAIN on unit 1).

config MONITOR_PCM_LINK_BENCH_TONE
    bool "Generate deterministic 1 kHz bench tone through the monitor PCM link"
    default n
    depends on MONITOR_PCM_LINK_ENABLED
    help
        Starts a bench task that enables the link and feeds a deterministic
        1 kHz -18 dBFS stereo sine at 48 kHz. Use only for the P4-to-S3 link
        bench pass; the product path publishes real hp_out blocks instead.

endmenu
