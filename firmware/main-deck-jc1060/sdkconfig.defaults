# JC1060-specific overrides applied after common P4 defaults.
CONFIG_PAJONIIIR_BOARD_JC1060=y
# GPIO50/51/52 belong to Ethernet, never enable PCM5102A here.
# CONFIG_BSP_PCM5102A_MAIN_OUT is not set
# USB-only MAIN and cue are paced by controller consumption, not the codec.
# CONFIG_BSP_ES8311_MONITOR is not set
CONFIG_ETH_USE_ESP32_EMAC=y
